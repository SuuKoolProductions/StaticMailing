# /submit-a-bug delivery. Preferred: a Slack bot token (scopes chat:write and
# files:write, bot invited to the channel) plus the channel ID (starts with C),
# which posts the report and uploads attachments into its thread.
SLACK_BOT_TOKEN=
SLACK_BUG_REPORT_CHANNEL_ID=
# Fallback when the bot vars are unset: incoming webhook, text only (attachments
# are named but not delivered). Same value the platform stores.
SLACK_BUG_REPORT_WEBHOOK_URL=
# Homepage access form only. This site does not use the platform database.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
